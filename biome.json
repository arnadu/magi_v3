{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/public/cockpit/**"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 25
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/agent-runtime-worker/src/cli-tool.ts",
				"packages/agent-runtime-worker/src/conversation-repository.ts",
				"packages/agent-runtime-worker/src/daemon-boot/orchestration-callbacks.ts",
				"packages/agent-runtime-worker/src/document-processor.ts",
				"packages/agent-runtime-worker/src/loop.ts",
				"packages/agent-runtime-worker/src/objectives/store.ts",
				"packages/agent-runtime-worker/src/reflection.ts",
				"packages/agent-runtime-worker/src/tools/fetch-url.ts",
				"packages/agent-runtime-worker/src/tools/research.ts",
				"packages/agent-runtime-worker/src/workspace-manager.ts",
				"packages/agent-runtime-worker/tests/browse-web.integration.test.ts",
				"packages/agent-runtime-worker/tests/data-factory.integration.test.ts",
				"packages/agent-runtime-worker/tests/fetch-share.integration.test.ts",
				"packages/agent-runtime-worker/tests/multi-agent.integration.test.ts",
				"packages/agent-runtime-worker/tests/skills.integration.test.ts",
				"packages/cockpit/src/FilesPanel.tsx",
				"packages/cockpit/src/Markdown.tsx",
				"packages/control-plane/src/copilot-daemon.ts",
				"packages/control-plane/src/missions.ts",
				"packages/control-plane/tests/support/fake-db.ts"
			],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					}
				}
			}
		}
	]
}
