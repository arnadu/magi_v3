secrets.env
secrets.env.*
!secrets.env.template
node_modules/
dist/
# Cockpit build output — generated by CI before docker build (see
# deploy-control-plane.yml); packages/cockpit/src is the committed source.
# Built straight into public/ (Sprint 27 retired the legacy index.html that
# used to live there, so the whole directory is now generated output).
packages/control-plane/public/
__pycache__/
*.pyc
*.js.map
.env
.env.local
.env.data-keys
*.log
coverage/
refs/
# Mission workspaces are live git repos managed by agents — keep fully out of the outer repo.
# To share outputs publicly, copy them to demos/ and commit there.
packages/agent-runtime-worker/missions/
packages/agent-runtime-worker/home/
# Local-execution team files (goals.json, skills/) land here when AGENT_WORKDIR
# defaults to cwd and the daemon/CLI is run from inside this package, per
# USER_GUIDE.md's documented local-execution flow — same artifact class as
# missions/ and home/ above, just missing from this list until now.
packages/agent-runtime-worker/team/
**/daemon.pid
# Stagehand/Playwright Chromium profile dirs (WSL2 UNC path garbage, now fixed but old ones may linger)
# Match \wsl.localhost* and \\wsl.localhost* at any depth (gitignore \\ = one literal \)
\\wsl.localhost*/
**/\\wsl.localhost*/
\\\\wsl.localhost*/
**/*\\wsl.localhost*/
packages/agent-runtime-worker/tests/browse-web-last-run.ndjson
fly.control-*.toml
!fly.control-dev.toml
!fly.control-test-hello-world.toml

