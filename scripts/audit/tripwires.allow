# Tripwire allowlist. Formats (see tripwires.sh):
#   <check-id> <regex-without-spaces>   # reason (owner, date)   -- drops matching "file:line:text" hits
#   <check-id> maxcount=<N>             # reason (owner, date)   -- noisy checks: fail only above N
# Ratchet rule: a maxcount may only go down; a regex entry may be removed, never widened, without a
# reason in the commit. The plan milestone that retires each entry is named in its reason.

# T1: the doc comment that explains why env expansion was removed (F-032) mentions process.env.
T1-env-in-config ^packages/agent-config/src/loader\.ts:[0-9]+:[[:space:]]*\* # comment, not code (remyh, 2026-10-16)

# T2: the cockpit's single sanctioned HTML sink; its input goes through renderMarkdown's escaping
# (F-049: & < > " ' escaped before any tag, URL-parser scheme allow-list). The legacy dashboard's
# 55 sinks are gone with it (M1 C2, F-052); any new hit here is a new sink to justify.
T2-html-sinks ^packages/cockpit/src/Markdown\.tsx: # sanctioned sink, escaped upstream (remyh, 2026-10-16)
# T3: the cockpit renderer's one link, whose href is safeLinkHref()'s output: URL-parsed, http/https/mailto
# only, attribute-escaped (XSS1). Unseen until 2026-10-23: a literal NUL in markdown.ts made grep skip the file.
T3-href-from-data ^packages/cockpit/src/markdown\.ts:[0-9]+:.*<a[[:space:]]href="\$\{href\}" # scheme allow-listed by safeLinkHref (remyh, 2026-10-23)

# T4: no entries — every daemon-identity path join goes through safe-path.ts since M1 B1 (F-037..F-041).
# A new hit here means a new raw join on agent-controlled input: use resolveInside/readInside/writeFileInside.

T5-spawn-env linux-user\.ts:[0-9]+:.*execFileSync\("id" # uidOf: fixed argv, PATH-only env, daemon identity (remyh, 2026-10-17)
T5-spawn-env maxcount=26 # reviewed one by one in M1 (B1/B4); each gets an explicit env or a regex entry here (remyh, 2026-10-16)
T6-git ^packages/agent-runtime-worker/src/safe-git\.ts: # the one sanctioned git call site (F-034) (remyh, 2026-10-16)
# T7: no entries — every async Express handler goes through async-handler.ts (F-060); a new bare
# `async (req, res)` handler is a hung request waiting to happen.
T8b-swallowed-promise close\(\)\.catch\(\(\) # closing a change stream, browser or egress proxy that is being discarded at teardown: there is nothing to recover (remyh, 2026-10-19)
T9-escape-hatches ^[^:]+:[0-9]+:[[:space:]]*(/?\*|//) # prose in comments ("as any other agent"), not a cast (remyh, 2026-10-19)
T9-escape-hatches ^packages/agent-runtime-worker/src/models\.ts:[0-9]+:.*getBuiltinModel # pi-ai types the id as its generated literal union; runtime OpenRouter ids are arbitrary (remyh, 2026-10-19)
T9-escape-hatches ^packages/agent-runtime-worker/src/daemon-boot/log-tee\.ts: # replacing process.stdout/stderr.write, whose overloads a wrapper cannot restate (remyh, 2026-10-19)
T9-escape-hatches ^packages/agent-runtime-worker/src/document-office\.ts:[0-9]+:.*(ArrayBuffer|mammoth) # library typings: exceljs takes a Buffer at runtime, mammoth omits convertToMarkdown (remyh, 2026-10-19)
T9-escape-hatches ^packages/agent-runtime-worker/src/objectives/repository\.ts:[0-9]+:.*as[[:space:]]unknown[[:space:]]as[[:space:]]E # one events collection, typed per kind by the caller (remyh, 2026-10-19)
T10-optional-cap ^packages/agent-config/src/loader\.ts:[0-9]+:[[:space:]]*maxCostUsd: # optional only in the input schema: every config write keeps or sets a cap (capForConfigWrite), every machine start ensures one (ensureMissionSpendCap), and the daemon falls back to the default — SCH-4 (remyh, 2026-10-22)
T11-comment-history maxcount=107 # INV-9: shrinks as comments are touched; no bulk rewrite (remyh, 2026-10-16)
# T12: no entries — the control plane writes mail through mailbox-writer.ts (postMailbox) and the
# daemon through MailboxRepository.post(); the repository's own insert is the one sanctioned site.
T12-raw-mailbox-insert ^packages/agent-runtime-worker/src/mailbox\.ts: # MailboxRepository.post, the writer itself (remyh, 2026-10-17)
# T13: no entries — every collection is reached through agent-config/src/stored (R-15).
T15-model-id-literal ^packages/(agent-config|agent-runtime-worker)/src/models\.ts: # the default ids and the price table are the model tables (remyh, 2026-10-19)
T15-model-id-literal ^[^:]+:[0-9]+:[[:space:]]*(/?\*|//) # an id named in a comment, not used (remyh, 2026-10-19)
