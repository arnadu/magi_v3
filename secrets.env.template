# MAGI V3 — secrets template
# Copy to secrets.env, fill in values, then run: bash scripts/bootstrap.sh
# secrets.env is gitignored and must never be committed.

# ── Core (required) ───────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
MONGODB_URI=

# Control plane operator password — generate with: openssl rand -hex 32
CONTROL_API_KEY=

# Signing key for per-mission MonitorServer tokens — generate with: openssl rand -hex 32
# Control plane only; never forwarded to execution plane machines.
MONITOR_SIGNING_KEY=

# ── Search and browsing (optional) ───────────────────────────────────────────

BRAVE_SEARCH_API_KEY=

# Alternative vision / BrowseWeb model provider
OPENROUTER_API_KEY=

# ── Firebase Auth ─────────────────────────────────────────────────────────────
# Server-side: Firebase Admin SDK (service account key JSON, minified to one line)
# Download from Firebase console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# Client-side: Firebase JS SDK config (public values — safe to store as Fly secrets)
# Find in Firebase console → Project Settings → General → Your apps → Web app → Config
FIREBASE_CLIENT_API_KEY=
FIREBASE_CLIENT_AUTH_DOMAIN=
FIREBASE_CLIENT_PROJECT_ID=

# ── GitHub Issues integration ─────────────────────────────────────────────────
# GitHub personal access token (classic) with repo scope — used by the copilot's
# ListIssues / CreateIssue / CloseIssue tools. Stored only in control plane.
# Create at: https://github.com/settings/tokens
GH_TOKEN=

# GitHub repository in owner/repo format (default: arnadu/magi_v3)
GITHUB_REPO=arnadu/magi_v3

# ── Resource oversight (ADR-0032, optional) ───────────────────────────────────

# Comma-separated Firebase UIDs — recipients of the atlas-storage-high alert
# and the daily report's Atlas section. Find a UID in the Firebase console
# under Authentication → Users. Empty is valid (logged on every tick; no one
# receives the Atlas alert or section) — set this once you know who should.
PLATFORM_ADMIN_USER_IDS=

# Shared MongoDB Atlas cluster storage quota in MB (default: 512, the M0 free-tier limit)
ATLAS_STORAGE_LIMIT_MB=512

# UTC hour (0-23) at or after which the daily resource report is sent (default: 12)
RESOURCE_REPORT_HOUR_UTC=12

# ── Data API keys (.env.data-keys equivalent) ─────────────────────────────────
# Forwarded to background jobs only — never to agent tool subprocesses.

FRED_API_KEY=
FMP_API_KEY=
NEWSAPIORG_API_KEY=
